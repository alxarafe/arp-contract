{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arp.example.invalid/proposals/physical/v1/physical.schema.json",
  "title": "ARP physical snapshot proposal (not published)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "sourceId",
    "object",
    "columns"
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "exactInteger": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    }
  },
  "properties": {
    "apiVersion": {
      "const": "arp.physical/v1"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
      "maxLength": 128
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "catalog": {
          "$ref": "#/$defs/name"
        },
        "schema": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "enum": [
            "TABLE",
            "VIEW"
          ]
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ordinal",
          "nativeType"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "nativeType": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "nullable": {
            "type": "boolean"
          },
          "identity": {
            "type": "boolean"
          },
          "generated": {
            "type": "boolean"
          },
          "integerRange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum",
              "maximum"
            ],
            "properties": {
              "minimum": {
                "$ref": "#/$defs/exactInteger"
              },
              "maximum": {
                "$ref": "#/$defs/exactInteger"
              }
            }
          },
          "characterLength": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 1
              },
              "unit": {
                "enum": [
                  "CHARACTERS",
                  "BYTES"
                ]
              }
            }
          },
          "decimalGeometry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "precision",
              "scale"
            ],
            "properties": {
              "precision": {
                "type": "integer",
                "minimum": 1
              },
              "scale": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "primaryKey": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "columns",
          "unique"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          },
          "unique": {
            "type": "boolean"
          }
        }
      }
    },
    "foreignKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "columns",
          "target"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/name"
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "table",
              "columns"
            ],
            "properties": {
              "catalog": {
                "$ref": "#/$defs/name"
              },
              "schema": {
                "$ref": "#/$defs/name"
              },
              "table": {
                "$ref": "#/$defs/name"
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            }
          }
        }
      }
    }
  }
}
