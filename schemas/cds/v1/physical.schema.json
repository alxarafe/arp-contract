{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alxarafe.org/arp/drafts/cds/v1/physical.schema.json",
  "title": "ARP-CDS-001 proposed physical descriptor (not published)",
  "type": "object",
  "required": [
    "apiVersion",
    "id",
    "kind",
    "source",
    "columns"
  ],
  "properties": {
    "apiVersion": {
      "const": "arp.physical/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(\\.[A-Za-z][A-Za-z0-9_-]*)+$",
      "maxLength": 128
    },
    "kind": {
      "enum": [
        "table",
        "view"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "dialect",
        "name"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "dialect": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "nativeType"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "nativeType": {
            "type": "string",
            "minLength": 1
          },
          "scalarType": {
            "enum": [
              "BOOLEAN",
              "STRING",
              "TEXT",
              "INT8",
              "UINT8",
              "INT16",
              "UINT16",
              "INT32",
              "UINT32",
              "INT64",
              "DECIMAL",
              "UUID",
              "DATE",
              "TIME",
              "DATETIME",
              "ENUM",
              "BINARY"
            ]
          },
          "nullable": {
            "type": "boolean"
          },
          "primaryKey": {
            "type": "boolean"
          },
          "minimum": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "maximum": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)$"
          },
          "maximumLength": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
