                    "minimum": 0,
                    "maximum": 99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999
                  },
                  "pattern": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^[\\u0020-\\u007e]*$(?![\\s\\S])",
                    "minLength": 1,
                    "description": "Printable ASCII and length only; portable pattern grammar checked independently."
                  }
                },
                "additionalProperties": false
              }
            },
