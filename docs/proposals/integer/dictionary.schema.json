{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARP INTEGER proposal — isolated structural sketch, not dictionary/v1",
  "description": "Structural validation; inference, integer range compatibility and exact numeric semantics require the contract semantic validator.",
