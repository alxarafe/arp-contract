[
  {
    "id": "providers-order-a",
    "steps": [
      {
        "operation": "buildCatalog",
        "context": "one",
        "sources": [
          {
            "providerId": "provider.a",
            "sourceId": "memory.a",
            "document": {
              "apiVersion": "arp.dictionary/v1",
              "elements": [
                {
                  "id": "test.a",
                  "type": "STRING"
                }
              ]
            }
          },
          {
            "providerId": "provider.b",
            "sourceId": "package.b",
            "document": {
              "apiVersion": "arp.dictionary/v1",
              "elements": [
                {
                  "id": "test.b",
                  "type": "INTEGER",
                  "constraints": {
                    "bits": 64,
                    "signed": true
                  }
                },
                {
                  "id": "test.A",
                  "type": "BOOLEAN"
                }
              ]
            }
          }
        ],
        "expected": {
          "valid": true,
          "issues": []
        }
      },
      {
        "operation": "resolve",
        "context": "one",
        "elementId": "test.b",
        "expected": {
          "valid": true,
          "issues": []
        },
        "descriptorProjection": {
          "id": "test.b",
          "type": "INTEGER",
          "constraints": {
            "bits": 64,
            "signed": true
          }
        }
      },
      {
        "operation": "resolve",
        "context": "one",
        "elementId": "test.a",
        "expected": {
          "valid": true,
          "issues": []
        },
        "descriptorProjection": {
          "id": "test.a",
          "type": "STRING",
          "constraints": {}
        }
      },
      {
        "operation": "resolve",
        "context": "one",
        "elementId": "test.A",
        "expected": {
          "valid": true,
          "issues": []
        },
        "descriptorProjection": {
          "id": "test.A",
          "type": "BOOLEAN",
          "constraints": {}
        }
      },
      {
        "operation": "resolve",
        "context": "one",
        "elementId": "test.missing",
        "expected": {
          "valid": false,
          "issues": [
            {
              "code": "DICTIONARY_ELEMENT_NOT_FOUND",
              "elementId": "test.missing"
            }
          ]
        }
      }
    ]
  },
