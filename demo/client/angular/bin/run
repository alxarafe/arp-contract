#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
contract="$(cd "$here/../../.." && pwd -P)"
aur="${ARP_UI_RUNTIME_PATH:-$(cd "$contract/../angular-ui-runtime" && pwd -P)}"
expected=ee60123d03f095a14c4004632c214dbd822332c2
if [[ "$(git -C "$aur" rev-parse HEAD)" != "$expected" || -n "$(git -C "$aur" status --porcelain)" ]]; then
    echo "Use a clean angular-ui-runtime checkout at $expected (ARP_UI_RUNTIME_PATH)." >&2
    exit 1
fi
node_image='node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9'
browser_image='mcr.microsoft.com/playwright:v1.58.2-noble@sha256:'
browser_image+='65cefd09a5e943921ecd3a6e5414c603db2eb161e9eb48f2e2ccc63486dc7dc0'
mkdir -p "$here/artifacts"
case "${1:-}" in
    build|check)
        docker run --rm --init --user "$(id -u):$(id -g)" \
            --env HOME=/tmp --env NG_CLI_ANALYTICS=false --env ARP_CONTRACT_PATH=/contract \
            --env "ARP_CONTRACT_REVISION=$(git -C "$contract" rev-parse HEAD)" \
            --env "AUR_SOURCE_COMMIT=$expected" --env AUR_SOURCE_STATUS=clean \
            --mount "type=bind,src=$aur,dst=/aur,readonly" \
            --mount "type=bind,src=$contract,dst=/contract,readonly" \
            --mount "type=bind,src=$here,dst=/source,readonly" \
            --mount "type=bind,src=$here/artifacts,dst=/artifacts" \
            "$node_image" bash /source/scripts/prepare.sh
        if [[ "$1" == check ]]; then
            docker run --rm --init --shm-size=1g --user "$(id -u):$(id -g)" \
                --env HOME=/tmp --env PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
                --mount "type=bind,src=$here/tests/browser,dst=/tests,readonly" \
                --mount "type=bind,src=$here/scripts,dst=/scripts,readonly" \
                --mount "type=bind,src=$contract,dst=/contract,readonly" \
                --mount "type=bind,src=$here/artifacts,dst=/artifacts" \
                "$browser_image" sh -eu -c \
                'mkdir /tmp/tests
                 cp -R /tests/. /tmp/tests/
                 cd /tmp/tests
                 npm ci --no-audit --no-fund
                 npx playwright test'
        fi
        ;;
    start)
        if [[ ! -f "$here/artifacts/site/index.html" ]]; then
            echo 'Run ./bin/run build first.' >&2
            exit 1
        fi
        docker run --rm --init --user "$(id -u):$(id -g)" \
            --publish 127.0.0.1:4173:4173 --env ARP_DEMO_HOST=0.0.0.0 \
            --mount "type=bind,src=$here/scripts,dst=/scripts,readonly" \
            --mount "type=bind,src=$here/artifacts,dst=/artifacts,readonly" \
            "$node_image" node /scripts/serve.mjs
        ;;
    *) echo 'Usage: ./bin/run {build|check|start}' >&2; exit 2 ;;
esac